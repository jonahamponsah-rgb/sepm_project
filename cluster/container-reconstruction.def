Bootstrap: docker
From: python:3.11-slim

%files
    ../requirements-cluster.txt /tmp/requirements-cluster.txt

%post
    apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
    python -m pip install --no-cache-dir -r /tmp/requirements-cluster.txt

%runscript
    exec python "$@"
