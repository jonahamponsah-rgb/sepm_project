universe = vanilla

# Container already copied to your new personal /staging path.
container_image = YOUR_CONTAINER_IMAGE_URI
requirements = (HasCHTCStaging == true)

executable = run_sepm_tmc.sh
arguments = $(dataset) $(fold) $(mode)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = sepm_tmc_bundle.tar.gz
transfer_output_files = sepm_tmc_$(dataset)_fold_$(fold)_$(mode).tar.gz

log = logs/sepm_tmc_$(dataset)_fold_$(fold)_$(mode).log
output = logs/sepm_tmc_$(dataset)_fold_$(fold)_$(mode).out
error = logs/sepm_tmc_$(dataset)_fold_$(fold)_$(mode).err

request_cpus = 2
request_memory = 8GB
request_disk = 25GB

queue dataset, fold, mode from jobs.txt
